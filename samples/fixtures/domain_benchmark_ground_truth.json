{
  "source": "C4C Domain Benchmark — 5 subjects (linear algebra / calculus / ODE / physics / probability)",
  "official_solutions": "由 SymPy 独立复算 + 教材标准结果双重确认（见 README「结果复现」一节）",
  "note": "基准题集的答案全部可以手工复算，不依赖任何外部解答。kind=exact 走数值/符号归一化比对，kind=contains 走关键结论比对。",
  "items": [
    {"id": "P1", "question": "det of [[2,1,0],[1,3,1],[0,1,4]]", "expected": "18", "kind": "exact"},
    {"id": "P2", "question": "inverse of [[2,0],[0,4]]", "expected": "[0.5, 0, 0, 0.25]",
     "accept": ["1/2","1/4","0.5","0.25"], "kind": "set"},
    {"id": "P3", "question": "eigenvalues of [[3,0],[0,-1]]", "expected": "-1 and 3", "kind": "set"},
    {"id": "P4", "question": "rank of [[1,2,3],[2,4,6],[3,6,9]]", "expected": "1", "kind": "exact"},
    {"id": "P5", "question": "solve [[1,2],[3,4]]x = [5,11]", "expected": "x = (1, 2)",
     "accept": ["1","2"], "kind": "set"},
    {"id": "P6", "question": "trace of [[5,1],[2,3]]", "expected": "8", "kind": "exact"},
    {"id": "P7", "question": "eigenvalues of [[0,1],[1,0]]", "expected": "-1 and 1", "kind": "set"},
    {"id": "P8", "question": "det of diag(1,2,3)", "expected": "6", "kind": "exact"},

    {"id": "P9", "question": "integral of x*e^x", "expected": "(x-1)e^x + C", "accept": ["x - 1"], "kind": "contains"},
    {"id": "P10", "question": "integral of x^2 from 0 to 1", "expected": "1/3",
     "accept": ["1/3", "0.3333"], "kind": "exact"},
    {"id": "P11", "question": "derivative of x^3 ln x", "expected": "x^2(3 ln x + 1)",
     "accept": ["3 log(x) + 1", "3*log(x)+1"], "kind": "contains"},
    {"id": "P12", "question": "integral of e^{-2x} from 0 to inf", "expected": "1/2",
     "accept": ["1/2", "0.5"], "kind": "exact"},
    {"id": "P13", "question": "Taylor of e^x about 0 to order 4",
     "expected": "1 + x + x^2/2 + x^3/6 + x^4/24",
     "accept": ["x^{5}/120", "x^5/120"], "kind": "contains"},
    {"id": "P14", "question": "gradient of x^2+y^2+z^2", "expected": "(2x, 2y, 2z)",
     "accept": ["2 x", "2 y", "2 z"], "kind": "set"},
    {"id": "P15", "question": "integral of 1/(1+x^2)", "expected": "atan(x) + C",
     "accept": ["atan", "arctan"], "kind": "contains"},

    {"id": "P16", "question": "y' = y", "expected": "y = C e^x", "accept": ["e^{x}"], "kind": "contains"},
    {"id": "P17", "question": "y' + 2y = 0", "expected": "y = C e^{-2x}",
     "accept": ["e^{- 2 x}", "e^{-2x}"], "kind": "contains"},
    {"id": "P18", "question": "y'' - y = 0", "expected": "y = C1 e^x + C2 e^{-x}",
     "accept": ["e^{x}", "e^{- x}"], "kind": "contains"},
    {"id": "P19", "question": "y'' + y = 0", "expected": "y = C1 cos x + C2 sin x",
     "accept": ["sin", "cos"], "kind": "contains"},
    {"id": "P20", "question": "y' = 2x, y(0)=1", "expected": "y = x^2 + 1", "accept": ["x^{2} + 1"], "kind": "contains"},
    {"id": "P21", "question": "Laplace transform of e^{-2t}", "expected": "1/(s+2)", "kind": "exact"},

    {"id": "P22", "question": "m=2 kg, a=3 m/s^2, F=?", "expected": "6 N", "kind": "exact"},
    {"id": "P23", "question": "m=4 kg, v=3 m/s, E_k=?", "expected": "18 J", "kind": "exact"},
    {"id": "P24", "question": "Coulomb q1=1e-6, q2=2e-6, r=0.1", "expected": "1.798 N",
     "accept": ["899/500", "1.798"], "kind": "exact"},
    {"id": "P25", "question": "I=2 A, R=5 ohm, V=?", "expected": "10 V", "kind": "exact"},
    {"id": "P26", "question": "pendulum L=1 m, T=?", "expected": "2.00709 s",
     "accept": ["2.00709", "200709/100000", "2.006"], "kind": "exact"},
    {"id": "P27", "question": "wave f=50 Hz, lambda=2 m, v=?", "expected": "100 m/s", "kind": "exact"},

    {"id": "P28", "question": "E(X), x={0,1,2}, p={0.2,0.5,0.3}", "expected": "1.1", "kind": "exact"},
    {"id": "P29", "question": "Var(X), same distribution", "expected": "0.49", "kind": "exact"},
    {"id": "P30", "question": "E(X) for X~B(10,0.5)", "expected": "5", "kind": "exact"},
    {"id": "P31", "question": "P(X<=1.96) for X~N(0,1)", "expected": "0.975",
     "accept": ["0.975", "0.9750"], "kind": "exact"}
  ]
}
